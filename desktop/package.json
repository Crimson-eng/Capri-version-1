{
  "name": "capri-desktop",
  "productName": "Capri",
  "version": "2.1.0",
  "description": "Mini Capri rondando por tu escritorio",
  "author": "Kiga",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node copy-web.js && electron .",
    "dist": "node copy-web.js && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.crimson.capri",
    "productName": "Capri",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "windows.js",
      "windows.ps1",
      "icon.png",
      "offline.html",
      "LICENSES/**",
      "web/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Capri-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Capri-portable-${version}.exe"
    },
    "asarUnpack": [
      "windows.ps1"
    ]
  }
}
